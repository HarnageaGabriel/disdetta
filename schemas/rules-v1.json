{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disdetta.dev/schemas/rules-v1.json",
  "title": "disdetta rules schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "kind", "severity", "level", "title", "oneLiner", "docs"],
        "properties": {
          "code": {"type": "string", "pattern": "^DSD-[A-Z]{3}-[0-9]{3}$"},
          "kind": {"enum": ["rule", "diagnostic"]},
          "severity": {"enum": ["", "high", "medium", "low"]},
          "level": {"enum": ["", "error", "warning", "info"]},
          "title": {"type": "string", "minLength": 1},
          "oneLiner": {"type": "string", "minLength": 1},
          "docs": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/HarnageaGabriel/disdetta/blob/main/docs/diagnostics/DSD-[A-Z]{3}-[0-9]{3}\\.md$"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "rule"}}}, "then": {"required": ["severity"], "properties": {"severity": {"enum": ["high", "medium", "low"]}, "level": {"const": ""}}}},
          {"if": {"properties": {"kind": {"const": "diagnostic"}}}, "then": {"required": ["level"], "properties": {"severity": {"const": ""}, "level": {"enum": ["error", "warning", "info"]}}}}
        ]
      }
    }
  }
}
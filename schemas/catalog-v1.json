{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chart", "appliesTo", "maturity", "routes", "mappings", "checklist"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "chart": {"type": "string", "minLength": 1},
    "appliesTo": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["verified", "partial", "route-only"]},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "recommended", "migration", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "apiVersion", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "apiVersion": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "recommended": {"type": "boolean"},
          "migration": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/sourceVerified"}
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "kind", "source"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "kind": {"enum": ["rename", "constant", "transform", "manual", "unmapped", "handled"]},
          "accepts": {"type": "string", "pattern": "^(quantity|dns-label|pg-identifier|resources|int|enum:[^|]+(?:\\|[^|]+)*)$"},
          "transform": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/sourceVerified"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"enum": ["rename", "constant"]}}}, "then": {"required": ["to", "accepts"]}},
          {"if": {"properties": {"kind": {"const": "transform"}}}, "then": {"required": ["to", "transform"]}},
          {"if": {"properties": {"kind": {"enum": ["manual", "unmapped", "handled"]}}}, "then": {"required": ["note"]}}
        ]
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {"url": {"type": "string", "pattern": "^https://"}}
    },
    "sourceVerified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "verified"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "verified": {"type": "string", "format": "date"}
      }
    }
  }
}

            {
              "id": "DSD-CFG-001",
              "name": "allowinsecureimages-is-enabled",
              "shortDescription": {
                "text": "allowInsecureImages is enabled"
              },
              "fullDescription": {
                "text": "Image verification is disabled by allowInsecureImages."
              },
              "helpUri": "https://github.com/HarnageaGabriel/disdetta/blob/main/docs/diagnostics/DSD-CFG-001.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "bitnami",
                  "security"
                ]
              }
            },
            {

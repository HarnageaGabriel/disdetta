{
  "schemaVersion": "1",
  "release": "pg",
  "chart": "postgresql",
  "chartVersion": "16.7.4",
  "route": "cloudnative-pg",
  "maturity": "partial",
  "target": {
    "apiVersion": "postgresql.cnpg.io/v1",
    "kind": "Cluster",
    "metadata": {
      "name": "pg"
    },
    "spec": {
      "bootstrap": {
        "initdb": {
          "database": "app"
        }
      },
      "instances": 1,
      "postgresql": {
        "parameters": {
          "auto_explain.log_min_duration": "1s",
          "pg_stat_statements.max": "10000",
          "pgaudit.log": "write, ddl"
        },
        "pg_hba": [
          "host all all 10.0.0.0/8 md5"
        ],
        "shared_preload_libraries": [
          "vector"
        ]
      }
    }
  },
  "unmapped": [
    {
      "path": "auth.password",
      "kind": "manual",
      "note": "credentials are never copied; create a basic-auth Secret"
    },
    {
      "path": "postgresqlSharedPreloadLibraries.pgaudit",
      "kind": "handled",
      "note": "loaded automatically by CloudNativePG"
    },
    {
      "path": "primary.configuration:line5",
      "kind": "manual",
      "note": "include directives require manual migration"
    },
    {
      "path": "primary.configuration:listen_addresses",
      "kind": "unmapped",
      "note": "fixed parameter managed by CloudNativePG; cannot be set"
    },
    {
      "path": "primary.configuration:port",
      "kind": "unmapped",
      "note": "fixed parameter managed by CloudNativePG; cannot be set"
    }
  ],
  "checklist": [
    {
      "text": "Choose microservice import for one database (roles are not imported) or monolith import for several databases (roles lose SUPERUSER; postgres is skipped).",
      "source": "https://cloudnative-pg.io/docs/1.30/database_import"
    },
    {
      "text": "Stop writes on the source before the final import; later changes are not copied.",
      "source": "https://cloudnative-pg.io/docs/1.30/database_import"
    },
    {
      "text": "Use a destination PostgreSQL major at least as new as the source; destination pg_dump is used.",
      "source": "https://cloudnative-pg.io/docs/1.30/database_import"
    },
    {
      "text": "Size PGDATA for the staged dump, data, and indexes.",
      "source": "https://cloudnative-pg.io/docs/1.30/database_import"
    },
    {
      "text": "Ensure the source is reachable and the import user can run pg_dump and read roles.",
      "source": "https://cloudnative-pg.io/docs/1.30/database_import"
    },
    {
      "text": "CloudNativePG defaults ssl_min_protocol_version to TLSv1.3; verify whether clients need TLS 1.2.",
      "source": "https://cloudnative-pg.io/docs/1.30/postgresql_conf"
    },
    {
      "text": "On PostgreSQL 14+, review md5 pg_hba rules before the default scram-sha-256 catch-all.",
      "source": "https://cloudnative-pg.io/docs/1.30/postgresql_conf"
    },
    {
      "text": "pgaudit requires a standard CloudNativePG operand image.",
      "source": "https://cloudnative-pg.io/docs/1.30/postgresql_conf"
    },
    {
      "text": "Resolve auth.password: credentials are never copied; create a basic-auth Secret",
      "source": "https://cloudnative-pg.io/docs/1.30/cloudnative-pg.v1"
    },
    {
      "text": "Resolve primary.configuration:line5: include directives require manual migration",
      "source": "https://cloudnative-pg.io/docs/1.30/postgresql_conf"
    }
  ],
  "coverage": {
    "mapped": 6,
    "total": 7,
    "derived": 4
  }
}

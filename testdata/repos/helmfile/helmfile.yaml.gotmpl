repositories:
- name: bitnami
  url: https://charts.bitnami.com/bitnami
releases:
- name: cache
  chart: bitnami/redis
  values:
  - image: {repository: bitnamilegacy/redis}
{{- if .Values.extra }}
- name: extra
  chart: bitnami/mongodb
{{- end }}
- name: postgres
  namespace: postgres
  labels:
    app: postgres
    tier: core
  version: 16.0.3
  chart: oci://registry-1.docker.io/bitnamicharts/postgresql
  set:
  - name: nameOverride
    value: postgres
  - name: auth.database
    value: ps_db
  - name: auth.username
    value: {{ .Values.postgres.user }}
  - name: image.repository
    value: bitnamilegacy/postgresql
- name: blobstore
  namespace: storage
  chart: bitnami/minio
  values:
  - extraEnvVars:
    - name: MINIO_DOMAIN
      value: blobstore.storage.example.com
    console:
      enabled: false
    resourcesPreset: small
    auth:
      rootPassword: {{ .Values.secrets.blobstorePassword }}
    image:
      repository: bitnamilegacy/minio
    global:
      security:
        allowInsecureImages: true
    persistence:
      enabled: true
      size: 10Gi
# bitnami is mentioned only in a comment

        },
        {
          "ruleId": "DSD-CFG-001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Image verification is disabled by allowInsecureImages. Reference: true"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "values.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 26
